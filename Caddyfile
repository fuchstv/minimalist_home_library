beta.sprachcafe-polnisch.org, http://3.66.205.213 {
    root * /var/www/beta
    encode zstd gzip

    handle /api/* {
        reverse_proxy cms_api:3001
    }

    handle {
        file_server
    }

    header {
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}

hausbibliothek.org, www.hausbibliothek.org {
    root * /usr/share/caddy
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:80
    }

    handle /uploads/* {
        reverse_proxy backend:80
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
