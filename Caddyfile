# Caddyfile - Central Reverse Proxy & Automatic TLS Configuration
{
    email admin@sprachcafe-polnisch.org
}

# ==============================================================================
# 1. Haupt-Website (Production): sprachcafe-polnisch.org & www.sprachcafe-polnisch.org & xn--sprachcaf-j4a.org (sprachcafé.org)
# -> Statische Dateien aus /var/www/production
# ==============================================================================
sprachcafe-polnisch.org, www.sprachcafe-polnisch.org, xn--sprachcaf-j4a.org, www.xn--sprachcaf-j4a.org {
    root * /var/www/production
    encode zstd gzip

    # 301 Redirects & Mappings
    redir /erfolgreicher-relaunch/ /posts/erfolgreicher-relaunch-webportal 301
    redir /erfolgreicher-relaunch /posts/erfolgreicher-relaunch-webportal 301
    redir /neue-buchbestaende-koepenick/ /posts/neue-buchbestaende-koepenick 301
    redir /neue-buchbestaende-koepenick /posts/neue-buchbestaende-koepenick 301
    redir /de/ / 301
    redir /de / 301
    redir /veranstaltungen/ /events/ 301
    redir /veranstaltungen /events/ 301
    redir /bibliothek/ /hausbibliothek/ 301
    redir /bibliothek /hausbibliothek/ 301

    # Mailchimp Webhook Endpoint (GET Handshake & POST Events)
    handle /api/webhooks/mailchimp* {
        header Content-Type "application/json; charset=utf-8"
        respond "{\"status\":\"ok\",\"service\":\"Mailchimp Webhook SprachCafe\",\"message\":\"Handshake verified\"}" 200
    }
    handle /api/mailchimp-webhook* {
        header Content-Type "application/json; charset=utf-8"
        respond "{\"status\":\"ok\",\"service\":\"Mailchimp Webhook SprachCafe\",\"message\":\"Handshake verified\"}" 200
    }

    # Basic Auth Protection for /reports/*
    basic_auth /reports/* {
        philipp $2a$14$DIRdKlU/PFEaHNqQb3FoS.9nR2sPHunOLWfctslP0O030QXWzeeiC
    }

    handle {
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# ==============================================================================
# 2. Beta / Staging Environment: beta.sprachcafe-polnisch.org
# -> Staging / Beta Statische Dateien aus /var/www/beta
# ==============================================================================
beta.sprachcafe-polnisch.org, http://3.66.205.213 {
    root * /var/www/beta
    encode zstd gzip

    # Basic Auth Protection for /reports/*
    basic_auth /reports/* {
        philipp $2a$14$DIRdKlU/PFEaHNqQb3FoS.9nR2sPHunOLWfctslP0O030QXWzeeiC
    }

    handle {
        file_server
    }

    header {
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}

# ==============================================================================
# 3. Hausbibliothek (Proxy): hausbibliothek.org
# ==============================================================================
hausbibliothek.org, www.hausbibliothek.org {
    root * /usr/share/caddy
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:80
    }

    handle /uploads/* {
        reverse_proxy backend:80
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}

# ==============================================================================
# 4. Intranet (Vanity URL / Redirection): intranet.sprachcafé.org
# -> Weiterleitung auf das Microsoft 365 SharePoint Intranet Hub
# ==============================================================================
intranet.xn--sprachcaf-j4a.org {
    encode zstd gzip
    redir https://sprachcafepolnisch.sharepoint.com/sites/intranet{uri} 302
}

intranet.sprachcafe-polnisch.org {
    encode zstd gzip
    redir https://sprachcafepolnisch.sharepoint.com/sites/intranet{uri} 302
}


